# ══════════════════════════════════════════════════════════════════════════════
# BudgetBy — Master Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your production/staging secrets.
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Telegram Bot & Channel ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@your_channel_username
TELEGRAM_BOT_USERNAME=@BudgetByBot
ADMIN_CHAT_ID=your_personal_telegram_chat_id

# ── 2. Telethon / MTProto Private Channel Listener ────────────────────────────
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here

# ── 3. Database (Supabase / PostgreSQL) ───────────────────────────────────────
# Recommended: Full Postgres connection URI (handles Supabase pooler automatically)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budgetby
DB_USER=budgetby
DB_PASSWORD=your_secure_password
DB_SSL=require
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── 4. Affiliate Network Monetization Keys ────────────────────────────────────
AMAZON_ASSOCIATE_TAG=dealpulse21-21
EARNKARO_API_KEY=5549565
CUELINKS_CHANNEL_ID=314807
CUELINKS_API_KEY=your_cuelinks_api_key_here

# ── 5. Control Center & API Security ──────────────────────────────────────────
ADMIN_SECRET_KEY=bb_sec_replace_with_32_character_random_hex_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
# Optional multiple admin credentials format: user1:pass1;user2:pass2
ADMIN_CREDENTIALS=
# Enable admin panel on cloud deployments (default false for stealth/security)
ENABLE_ADMIN_PANEL=false
# Enable APScheduler background tasks inside web worker (default false, run on local daemon)
ENABLE_CLOUD_SCHEDULER=false
# Whitelisted CORS origins (comma-separated)
ALLOWED_ORIGINS=https://budgetby.in,https://www.budgetby.in,http://localhost:8000

# ── 6. Server Network & Port Configuration ────────────────────────────────────
PORT=5000
DASHBOARD_PORT=5000
HOST=0.0.0.0
